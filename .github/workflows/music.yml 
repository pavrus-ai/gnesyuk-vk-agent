name: Music Agent (VK)

on:
  workflow_dispatch:
  schedule:
    - cron: "0 12 * * *"  # Каждый день в 12:00 UTC (можно изменить время)

jobs:
  music:
    runs-on: ubuntu-latest
    permissions:
      contents: write

    steps:
      - uses: actions/checkout@v4
      
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          
      - run: pip install requests beautifulsoup4
      
      - name: Run Music agent
        run: python music_agent.py
        env:
          GROQ_KEY: ${{ secrets.GROQ_KEY }}
          OPENROUTER_KEY: ${{ secrets.OPENROUTER_KEY }}
          VK_TOKEN: ${{ secrets.VK_TOKEN }}
          VK_GROUP_ID: ${{ secrets.VK_GROUP_ID }}
          
      - name: Commit music images and cache
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add img/ music_cache.json music_history.json
          git diff --quiet && git diff --staged --quiet || (git commit -m "chore: update music covers and cache [skip ci]" && git push)
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
